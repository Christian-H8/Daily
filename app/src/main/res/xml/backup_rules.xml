<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 Auto Backup rules (android:fullBackupContent). Ignored on API 31+,
  and minSdk is 31, so no supported device reads this file. Kept in step with
  data_extraction_rules.xml so lowering minSdk can never silently re-enable
  cloud backup of notes.
-->
<full-backup-content>
    <exclude domain="file" path="notes.json" />
    <exclude domain="file" path="notes.json.tmp" />
</full-backup-content>
